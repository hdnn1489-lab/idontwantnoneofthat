---
import { type Lang, t, home, page, other } from '../i18n';
import { SITE } from '../site';

interface Props {
  lang: Lang;
  switchTo: string;
}
const { lang, switchTo } = Astro.props;
const s = t(lang);
const prefix = lang === 'vi' ? '/vi' : '';
---

<header class="site-header">
  <div class="wrap bar">
    <a href={home(lang)} class="wordmark logo">{SITE.name}<em>{SITE.tld}</em></a>
    <div class="controls">
      <div class="lang" role="group" aria-label={lang === 'vi' ? 'Ngôn ngữ' : 'Language'}>
        {
          lang === 'en' ? (
            <>
              <span class="lang-on" aria-current="true">EN</span>
              <a href={switchTo} lang="vi" hreflang="vi" data-set-lang="vi">VI</a>
            </>
          ) : (
            <>
              <a href={switchTo} lang="en" hreflang="en" data-set-lang="en">EN</a>
              <span class="lang-on" aria-current="true">VI</span>
            </>
          )
        }
      </div>
      <button type="button" class="icon-btn theme-btn" data-theme-toggle aria-label={s.themeToggle}>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button type="button" class="icon-btn menu-btn" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label={s.menu}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
      </button>
    </div>
    <nav id="site-nav" aria-label={lang === 'vi' ? 'Chính' : 'Main'}>
      <a href={`${home(lang)}#latest`}>{s.navPosts}</a>
      <a href={`${prefix}/series/none-of-that/`}>None of that</a>
      <a href={`${prefix}/series/some-of-this/`}>Some of this</a>
      <a href={page(lang, 'ask')}>{s.navAsk}</a>
      <a href={page(lang, 'about')}>{s.navAbout}</a>
      <button type="button" class="nav-theme" data-theme-toggle>{s.themeToggle}</button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo nav controls';
    align-items: center;
    gap: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .logo {
    grid-area: logo;
    font-size: 24px;
  }
  nav {
    grid-area: nav;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 20px;
    font-family: var(--sans);
    font-size: 15px;
  }
  nav a {
    text-decoration: none;
    padding: 10px 0;
  }
  nav a:hover {
    color: var(--lip);
  }
  .controls {
    grid-area: controls;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang {
    display: flex;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
  }
  .lang a,
  .lang span {
    padding: 8px 13px;
    border-radius: 999px;
    text-decoration: none;
    line-height: 1;
  }
  .lang a {
    color: var(--muted);
  }
  .lang a:hover {
    color: var(--ink);
  }
  .lang-on {
    background: var(--raise);
  }
  .icon-btn {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .icon-btn:hover {
    border-color: var(--ink);
  }
  .sun {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: block;
  }
  :global([data-theme='dark']) .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }
  .menu-btn,
  .nav-theme {
    display: none;
  }
  .nav-theme {
    background: none;
    border: 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font: inherit;
    text-align: left;
    padding: 12px 0;
    cursor: pointer;
  }

  @media (max-width: 980px) {
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'logo controls' 'nav nav';
      row-gap: 0;
    }
    .menu-btn {
      display: inline-flex;
    }
    nav {
      display: none;
      flex-direction: column;
      gap: 0;
      padding-top: 12px;
      font-size: 17px;
    }
    nav:global(.is-open) {
      display: flex;
    }
    nav a {
      padding: 12px 0;
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 520px) {
    .theme-btn {
      display: none;
    }
    .nav-theme {
      display: block;
    }
    .logo {
      font-size: 17px;
    }
    .controls {
      gap: 6px;
    }
    .lang a,
    .lang span {
      padding: 8px 10px;
    }
  }
</style>
