---
import { type Lang, t, page } from '../i18n';
import { SITE } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="about">
      <span class="wordmark name">{SITE.name}<em>{SITE.tld}</em></span>
      <p>
        {s.notTherapy} <a href={page(lang, 'support')}>{s.supportResources}</a>.
      </p>
    </div>
    <ul class="links">
      {
        SITE.instagram && (
          <li>
            <a href={`https://instagram.com/${SITE.instagram}`} rel="me noopener">
              Instagram @{SITE.instagram}
            </a>
          </li>
        )
      }
      <li><a href="/rss.xml">RSS (EN)</a></li>
      <li><a href="/vi/rss.xml">RSS (VI)</a></li>
      <li><a href={page(lang, 'about')}>{s.navAbout}</a></li>
    </ul>
    <p class="sign">{s.madeWith}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 40px;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 28px;
    padding-top: 40px;
    padding-bottom: 56px;
    font-family: var(--sans);
    font-size: 14px;
    color: var(--muted);
  }
  .about {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .name {
    font-size: 20px;
  }
  .about p {
    margin: 0;
    line-height: 1.6;
    max-width: 440px;
  }
  .about a {
    color: var(--lip);
    font-weight: 600;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    align-items: flex-start;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
    display: inline-block;
    padding: 8px 0;
  }
  .links a:hover {
    color: var(--lip);
  }
  .sign {
    flex-basis: 100%;
    margin: 0;
    font-family: var(--serif-display);
    font-style: italic;
    font-size: 16px;
  }
</style>
