---
import Base from '../layouts/Base.astro';
---

<Base lang="en" title="Not found">
  <div class="wrap nf">
    <p class="eyebrow">404</p>
    <h1 class="display">This page? <em>We don't want none of that</em> either.</h1>
    <p class="vi" lang="vi">Trang này không tồn tại. Thôi, khỏi nha.</p>
    <div class="actions">
      <a class="btn btn--lip" href="/">Back to the good stuff</a>
      <a class="btn btn--ghost" href="/vi/" lang="vi">Về trang chủ</a>
    </div>
  </div>
</Base>

<style>
  .nf {
    padding-top: 100px;
    padding-bottom: 80px;
    max-width: 820px;
  }
  .nf .eyebrow {
    margin: 0 0 16px;
  }
  h1 {
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.05;
    margin: 0;
  }
  h1 em {
    font-style: italic;
    color: var(--lip);
  }
  .vi {
    font-size: 20px;
    color: var(--muted);
    margin: 24px 0 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
</style>
